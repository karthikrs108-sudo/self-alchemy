      .journey-form {
        max-width: 900px;
      }

      .form-grid {
        display: grid;

        grid-template-columns:
          1fr 1fr;

        gap: 22px;
      }

      .form-field {
        display: flex;

        flex-direction: column;

        gap: 8px;

        margin-bottom: 22px;
      }

      .form-field label {
        font-size: 0.85rem;

        font-weight: 700;
      }

      .form-field input,
      .form-field select,
      .form-field textarea {
        width: 100%;

        padding: 14px 16px;

        border:
          1px solid rgba(255,255,255,0.25);

        border-radius: 10px;

        background:
          rgba(255,255,255,0.08);

        color: white;

        font: inherit;
      }

      .form-field input::placeholder,
      .form-field textarea::placeholder {
        color:
          rgba(255,255,255,0.5);
      }

      .form-field select option {
        color: var(--text);
      }

      .form-field textarea {
        resize: vertical;
      }

      .form-button {
        border: 0;
      }

      .form-note {
        margin-top: 15px;

        color:
          rgba(255,255,255,0.5);

        font-size: 0.8rem;
      }


