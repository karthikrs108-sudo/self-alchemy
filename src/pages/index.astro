          </h4>

          <a href="#">
            Instagram
          </a>

          <a href="#">
            YouTube
          </a>

          <a href="#">
            LinkedIn
          </a>

          <a href="mailto:karthikrs108108@gmail.com">
            Contact
          </a>

        </div>

      </div>


      <div class="footer-bottom">

        <p>
          © 2026 Self Alchemy. All rights reserved.
        </p>

        <div>

          <a href="https://sites.google.com/d/1UzP6miwGWjUzMLiuCWiGiD5e0zAdOvQR/p/1q4B_I1-F3z37UQWlDJAdzi8hyHtvrV2v/edit">
            Privacy Policy
          </a>

          <a href="https://sites.google.com/d/1CqL_fnmV0BRH9xnMRbktyvuZRTBOpcg_/p/1t-8rt3PdzGHVj59oZNSorKIOlL-Jnqx4/edit">
            Terms
          </a>

          

        </div>

      </div>

    </footer>


    <style>

      /* ==================================================
         VARIABLES
      ================================================== */

      :global(:root) {
        --green: #31594d;
        --green-dark: #24463d;
        --green-soft: #55766a;

        --cream: #f6f0e4;
        --cream-dark: #ebe0cf;

        --orange: #c77b4a;
        --orange-light: #dfa27a;

        --text: #29342f;
        --muted: #65716b;
        --white: #ffffff;

        --border: rgba(49, 89, 77, 0.18);

        --max-width: 1180px;
        --radius: 22px;
      }


      /* ==================================================
         RESET
      ================================================== */

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;

        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        color: var(--text);
        background: var(--cream);
        line-height: 1.7;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      :global(img) {
        max-width: 100%;
      }


      /* ==================================================
         TYPOGRAPHY
      ================================================== */

      h1,
      h2,
      h3,
      h4,
      p {
        margin-top: 0;
      }

      h1,
      h2,
      h3 {
        line-height: 1.15;
      }

      h1 {
        font-size: clamp(2.8rem, 6vw, 5.2rem);
      }

      h2 {
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        color: var(--orange)
      }

      h2 {
        font-size: clamp(2.2rem, 4vw, 3.5rem);
        color: var(--orange)
      }

      .journey-heading h2 {
        color: var(--orange) !important;
      }

      h3 {
        font-size: 1.35rem;
      }


      /* ==================================================
         CONTAINERS
      ================================================== */

      .section-container {
        width: min(
          calc(100% - 40px),
          var(--max-width)
        );

        margin: 0 auto;
      }

      .section-intro {
        max-width: 720px;
        margin-bottom: 60px;
      }

      .section-intro.centered {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .section-label {
        color: var(--orange);

        font-size: 0.78rem;
        font-weight: 800;

        letter-spacing: 3px;
        text-transform: uppercase;

        margin-bottom: 18px;
      }

      .light-label {
        color: var(--orange-light);
      }


      /* ==================================================
         HEADER
      ================================================== */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 30px;

        padding: 16px 5%;

        background: rgba(246, 240, 228, 0.94);

        backdrop-filter: blur(12px);

        border-bottom: 1px solid var(--border);
      }

      .logo-link img {
        display: block;
        width: 115px;
        height: auto;
      }

      .site-header nav {
        display: flex;
        gap: 24px;
        align-items: center;
      }

      .site-header nav a {
        font-size: 0.86rem;
        font-weight: 600;

        transition: color 0.2s ease;
      }

      .site-header nav a:hover {
        color: var(--orange);
      }

      .header-cta {
        padding: 11px 18px;

        border: 1px solid var(--green);
        border-radius: 100px;

        color: var(--green);

        font-size: 0.85rem;
        font-weight: 700;

        transition: all 0.2s ease;
      }

      .header-cta:hover {
        background: var(--green);
        color: white;
      }


      /* ==================================================
         BUTTONS
      ================================================== */

      .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 14px;

        padding: 15px 25px;

        border: 0;
        border-radius: 100px;

        background: var(--orange);
        color: white;

        font: inherit;
        font-weight: 700;

        cursor: pointer;

        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .cta-button:hover {
        transform: translateY(-2px);
        background: #b96d3d;
      }

      .outline-button {
        display: inline-flex;
        align-items: center;
        gap: 12px;

        margin-top: 15px;
        padding: 13px 21px;

        border: 1px solid rgba(49, 89, 77, 0.35);
        border-radius: 100px;

        color: var(--green);
        font-weight: 700;
      }

      .outline-button:hover {
        background: rgba(49, 89, 77, 0.06);
      }


      /* ==================================================
         HERO
         KEPT AS EXISTING
      ================================================== */

      .hero {
        position: relative;
        overflow: hidden;

        min-height: 720px;

        display: flex;
        align-items: center;

        padding: 80px 0 100px;

        background: var(--green);
        color: white;
      }

      .hero-layout {
        position: relative;
        z-index: 2;

        width: min(
          calc(100% - 40px),
          var(--max-width)
        );

        margin: 0 auto;

        display: grid;
        grid-template-columns: 1fr 0.9fr;

        align-items: center;

        gap: 70px;
      }

      .hero-copy {
        max-width: 650px;
      }

      .hero-label {
        color: var(--orange-light);

        font-size: 1.85rem;
        font-weight: 800;

        letter-spacing: 4px;
      }

      .hero h1 {
        margin: 20px 0 28px;
      }

      .hero-lead {
        max-width: 600px;

        font-size: 1.25rem;
        line-height: 1.6;
      }

      .hero-description {
        max-width: 560px;

        color: rgba(255,255,255,0.78);

        margin-bottom: 30px;
      }

      .hero-visual {
        position: relative;
        min-height: 480px;

        display: flex;
        align-items: center;
        justify-content: center;
      }

      .hero-visual-shape {
        position: absolute;

        width: 430px;
        height: 430px;

        background: var(--orange);

        border-radius:
          52% 48% 43% 57% /
          45% 55% 47% 53%;

        opacity: 0.8;

        transform: rotate(-12deg);
      }

      .hero-image {
        position: relative;
        z-index: 2;

        width: 160%;
        max-width: 2800px;

        height: 190%;

        object-fit: cover;
        object-position: center 50%;

        transform: translateX(30px);

        filter: drop-shadow(
          0 25px 35px rgba(0,0,0,0.15)
        );
      }

      .hero-decoration {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
      }

      .hero-decoration-one {
        width: 180px;
        height: 180px;

        right: -80px;
        top: 60px;

        background: var(--orange);
        opacity: 0.13;
      }

      .hero-decoration-two {
        width: 100px;
        height: 100px;

        left: 8%;
        bottom: -45px;

        background: var(--cream);
        opacity: 0.12;
      }


      /* ==================================================
         WHAT IS SELF ALCHEMY
         Existing retreat structure, now cream
      ================================================== */

      .self-alchemy-section {
        position: relative;
        overflow: hidden;

        padding: 120px 0;

        background: var(--cream);
        color: var(--text);
      }

      .retreat-layout {
        position: relative;
        z-index: 2;

        display: grid;

        grid-template-columns: 1fr 0.9fr;

        gap: 80px;

        align-items: center;
      }

      .retreat-copy {
        max-width: 620px;
      }

      .retreat-copy h2 {
        margin-bottom: 30px;
      }

      .retreat-lead {
        font-size: 1.25rem;
      }

      .retreat-copy p {
        color: var(--muted);
      }

      .retreat-copy strong {
        color: var(--text);
      }

      .self-alchemy-label {
        color: var(--orange);
      }

      .retreat-words {
        display: flex;
        flex-wrap: wrap;

        gap: 10px;

        margin: 30px 0;
      }

      .retreat-words span {
        padding: 7px 13px;

        border: 1px solid rgba(49,89,77,0.25);
        border-radius: 100px;

        color: var(--green);

        font-size: 0.85rem;
      }

      .retreat-visual {
        position: relative;
      }

      .image-placeholder {
        display: flex;

        flex-direction: column;
        align-items: center;
        justify-content: center;

        min-height: 340px;

        border: 1px dashed rgba(49,89,77,0.35);
        border-radius: 35px;

        background: rgba(49,89,77,0.04);

        text-align: center;
      }

      .retreat-image-placeholder img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        border-radius: 35px;
      }

      .retreat-themes {
        margin-top: 18px;
        padding: 25px;

        background: white;
        color: var(--text);

        border-radius: var(--radius);

        border: 1px solid var(--border);
