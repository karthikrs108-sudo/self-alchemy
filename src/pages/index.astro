        position: absolute;

        width: 220px;
        height: 220px;

        left: -100px;
        bottom: -90px;

        background: var(--orange);

        border-radius: 50%;

        opacity: 0.12;
      }


      /* ==================================================
         HOW IT WORKS
         Existing structure retained
      ================================================== */

      .how-it-works {
