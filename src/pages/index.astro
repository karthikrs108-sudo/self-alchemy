        margin: 0 auto;

        padding: 70px 0;

        display: grid;

        grid-template-columns:
          1.5fr 1fr 1fr;

        gap: 60px;
      }

      .footer-brand h3 {
        color: var(--orange-light);
      }

      .footer-brand p {
        max-width: 350px;

        color:
          rgba(255,255,255,0.65);
      }

      .footer-column {
        display: flex;

        flex-direction: column;

        gap: 9px;
      }

      .footer-column h4 {
        margin-bottom: 10px;

        color: var(--orange-light);
      }

      .footer-column a {
        color:
          rgba(255,255,255,0.7);

        font-size: 0.9rem;
      }

      .footer-column a:hover {
        color: white;
      }

      .footer-bottom {
        width: min(
          calc(100% - 40px),
          var(--max-width)
        );

        margin: 0 auto;

        padding: 22px 0;

        display: flex;

        justify-content: space-between;

        gap: 20px;

        border-top:
          1px solid rgba(255,255,255,0.12);

        color:
          rgba(255,255,255,0.5);

        font-size: 0.78rem;
      }

      .footer-bottom div {
        display: flex;

        gap: 20px;
      }


      /* ==================================================
         RESPONSIVE
      ================================================== */

      @media (max-width: 950px) {

        .site-header nav {
          gap: 12px;
        }

        .hero-layout,
        .retreat-layout,
        .next-inner {
          grid-template-columns: 1fr;

          gap: 55px;
        }

        .hero {
          padding-top: 70px;
        }

        .hero-copy {
          text-align: center;

          margin: 0 auto;
        }

        .hero-visual {
          min-height: 400px;
        }

        .hero-description {
          margin-left: auto;
          margin-right: auto;
        }

        .next-copy {
          margin: 0 auto;

          text-align: center;
        }

        .next-buttons {
          justify-content: center;
        }

        .next-visual {
          min-height: 380px;
        }

        .how-steps {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .founder-grid {
          grid-template-columns: 1fr;

          max-width: 600px;

          margin: 0 auto;
        }

      }


      @media (max-width: 700px) {

        .site-header {
          padding: 14px 20px;
        }

        .site-header nav {
          display: none;
        }

        .header-cta {
          padding: 9px 13px;

          font-size: 0.75rem;
        }

        .section-container {
          width: min(
            calc(100% - 30px),
            var(--max-width)
          );
        }

        .hero-layout {
          width: min(
            calc(100% - 30px),
            var(--max-width)
          );
        }

        .hero {
          padding: 70px 0 80px;
        }

        .hero-visual {
          min-height: 320px;
        }

        .hero-visual-shape {
          width: 300px;
          height: 300px;
        }

        .self-alchemy-section,
        .next-self-alchemy,
        .how-it-works,
        .founders,
        .testimonials,
        .journey {
          padding: 80px 0;
        }

        .how-steps {
          grid-template-columns: 1fr;
        }

        .testimonial-video-grid {
          grid-template-columns: 1fr;
        }

        .testimonial-video iframe {
          height: 300px;
        }

        .form-grid {
          grid-template-columns: 1fr;

          gap: 0;
        }

        .theme-item {
          grid-template-columns: 1fr;

          gap: 3px;
        }

        .footer-main {
          grid-template-columns:
            1fr 1fr;
        }

        .footer-brand {
          grid-column: 1 / -1;
        }

        .footer-bottom {
          flex-direction: column;
        }

        .founder-orbit {
          transform: scale(0.85);

          margin-top: 30px;
          margin-bottom: 30px;
        }

      }


      @media (max-width: 450px) {

        .logo-link img {
          width: 95px;
        }

        .header-cta {
          display: none;
        }

        .hero h1 {
          font-size: 2.6rem;
        }

        .hero-lead {
          font-size: 1.05rem;
        }

        .hero-visual {
          min-height: 270px;
        }

        .hero-visual-shape {
          width: 250px;
          height: 250px;
        }

        .next-visual {
          min-height: 300px;
        }

        .next-visual-shape {
          width: 270px;
          height: 270px;
        }

        .testimonial-video iframe {
          height: 240px;
        }

        .footer-main {
          grid-template-columns: 1fr;
        }

        .footer-brand {
          grid-column: auto;
        }

        .footer-bottom div {
          flex-wrap: wrap;
        }

      }

    </style>

