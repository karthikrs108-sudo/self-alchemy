        padding: 120px 0;

        background: white;

        overflow: hidden;
      }

      .how-steps {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 24px;
      }

      .how-step {
        position: relative;

        min-height: 300px;

        padding: 35px;

        border-radius: var(--radius);

        background: var(--cream);

        border: 2px solid var(--green);

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .how-step:hover {
        transform: translateY(-5px);

        box-shadow:
          0 15px 35px rgba(49,89,77,0.1);
      }

      .step-one {
        border-color: var(--orange);
      }

      .step-two {
        border-color: var(--green);
      }

      .step-three {
        border-color: var(--orange);
      }

      .step-number {
        margin-bottom: 45px;

        color: var(--orange);

        font-size: 0.85rem;
        font-weight: 800;

        letter-spacing: 2px;
      }

      .how-step p {
        color: var(--muted);
      }

      .how-statement {
        position: relative;

        max-width: 850px;

        margin: 70px auto 0;

        padding: 35px 45px;

        border-radius: var(--radius);

        background: var(--green);

        color: white;

        text-align: center;
