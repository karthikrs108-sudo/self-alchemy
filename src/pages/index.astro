---
const founders = [
  {
    name: "Karthik Ritty Sudarshan",
    role: "Astrologer • Life Coach",
    image: "/images/founder-karthik.png",
    text: "Karthik brings together astrological understanding, coaching, and experiential learning to help participants explore themselves with greater awareness and perspective."
  },
  {
    name: "Muthu Vijayan Elango",
    role: "Astrologer • Author • Instructor • Life Coach",
    image: "/images/founder-muthu.png",
    text: "With more than two decades of experience in Astrology, Muthu has taught thousands of students and worked with people navigating some of life's most important questions."
  },
  {
    name: "Aswin Subramanyan",
    role: "Astrologer • Author • Instructor",
    image: "/images/founder-aswin.png",
    text: "With more than 15 years of experience in Vedic Astrology, Aswin has guided thousands of people and has a strong hold in Western, Greek and medieval techniques."
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      Self Alchemy — Transform the Way You Understand Yourself
    </title>

    <meta
      name="description"
      content="Self Alchemy brings together Astrology, Psychology-informed self-reflection, and guided mentorship to create meaningful transformation."
    />
  </head>

  <body>

    <!-- ==================================================
         HEADER
    ================================================== -->

    <header class="site-header">

      <a href="/" class="logo-link">
        <img
          src="/No BG Logo.png"
          alt="Self Alchemy"
        />
      </a>

      <nav>
        <a href="#what-is-self-alchemy">
          What Is Self Alchemy
        </a>

        <a href="#next-self-alchemy">
          Next Self Alchemy
        </a>

        <a href="#how-it-works">
          How It Works
        </a>

        <a href="/founders">
          Founders
        </a>

        <a href="#testimonials">
          Testimonials
        </a>
      </nav>

      <a href="#journey" class="header-cta">
        Book Your Slot
      </a>

    </header>


    <main>

       <!-- ==================================================
           HERO
      ================================================== -->

      <section class="hero">

        <div class="hero-decoration hero-decoration-one"></div>
        <div class="hero-decoration hero-decoration-two"></div>

        <div class="hero-layout">

          <div class="hero-copy">

            <p class="hero-label">
              SELF ALCHEMY
            </p>

            <h1>
              Transform your life
            </h1>

            <p class="hero-lead">
              A journey of self-discovery through Astrology, reflection, and mentorship.
            </p>

            

            <a href="#journey" class="cta-button">
              Begin Your Journey
              <span>→</span>
            </a>

          </div>


          <div class="hero-visual">

            <div class="hero-visual-shape"></div>

            <img
              src="/images/hero.png"
              alt="A contemplative journey toward clarity"
              class="hero-image"
            />

          </div>

        </div>

      </section>



      <!-- ==================================================
           WHAT IS SELF ALCHEMY
           Existing Retreat section moved here.
           Structure retained.
      ================================================== -->

      <section
        class="retreats self-alchemy-section"
        id="what-is-self-alchemy"
      >

        <div class="retreat-decoration"></div>

        <div class="section-container retreat-layout">

          <div class="retreat-copy">

            <!--<p class="section-label self-alchemy-label">
              WHAT IS SELF ALCHEMY
            </p> -->

            <h2>
              WHAT IS SELF ALCHEMY
            </h2>

            <!--<p class="retreat-lead">
              Sometimes transformation requires more than a conversation.
            </p>

            <p>
              It requires stepping away from your routine, creating
              space to think, and experiencing yourself from a
              different perspective.
            </p> -->

            <p>
              Self Alchemy retreats combine <strong>Astrology,
              Life Coaching, guided introspection, experiential
              exercises, stories, metaphors, personal mentoring,
              and reflective practices</strong> in carefully designed
              immersive experiences.
            </p>

            <!--<div class="retreat-words">

              <span>You reflect.</span>
              <span>You experience.</span>
              <span>You question.</span>
              <span>You discover.</span>

            </div> 

            <p>
              And you return with something tangible — greater
              self-awareness, a clearer perspective, and practical
              insights you can carry into everyday life.
            </p> -->

            <a href="#next-self-alchemy" class="outline-button">
              Explore Upcoming Retreats
              <span>→</span>
            </a>

          </div>


          <div class="retreat-visual">

            <div class="image-placeholder retreat-image-placeholder">

              <img
                src="/images/retreat.png"
                alt="Self Alchemy retreat experience"
              />

            </div>


            <div class="retreat-themes">

              <h3>
                Our Retreat Themes
              </h3>

              <div class="theme-item">
                <strong>Career & Purpose</strong>
                <span>
                  Understand your strengths, values and direction.
                </span>
              </div>

              <div class="theme-item">
                <strong>Relationships</strong>
                <span>
                  Explore the patterns that shape how you connect with others.
                </span>
              </div>

              <div class="theme-item">
                <strong>Marital Harmony</strong>
                <span>
                  Create space to understand, reconnect, and strengthen your relationship.
                </span>
              </div>

              <div class="theme-item">
                <strong>Personal Transformation</strong>
                <span>
                  Go deeper into identity, beliefs, values, and the life you want to create.
                </span>
              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- ==================================================
           WHEN IS THE NEXT SELF ALCHEMY
      ================================================== -->

      <section
        class="next-self-alchemy"
        id="next-self-alchemy"
      >

        <div class="next-self-alchemy-decoration"></div>

        <div class="section-container">

          <div class="next-inner">

            <div class="next-copy">

              <p class="section-label">
                
              </p>

              <h2>
                UPCOMING SELF ALCHEMY
              </h2>

              <!--
                CHANGE THIS DATE / DETAILS WHEN NEEDED.
                This is intentionally easy to update.
              -->

              <p class="next-date">
                The next Self Alchemy experience is coming soon.
              </p>

              <p>
                Spaces are limited so that every participant
                receives the attention and space required for
                meaningful reflection and transformation.
              </p>

              <div class="urgency-note">
                <span>✦</span>
                <strong>
                  Reserve your place before the next experience fills.
                </strong>
              </div>


              <div class="next-buttons">

                <a
                  href="https://wa.me/918951498824"
                  class="cta-button"
                  target="_blank"
                  rel="noopener"
                >
                  Book My Slot
                  <span>→</span>
                </a>

                <a
                  href="#journey"
                  class="next-form-button"
                >
                  Register Your Interest
                </a>

              </div>

            </div>


            <div class="next-visual">

              <div class="next-visual-shape"></div>

              <img
                src="/images/retreat1.png"
                alt="Self Alchemy retreat"
              />

            </div>

          </div>

        </div>

      </section>


      <!-- ==================================================
           HOW SELF ALCHEMY WORKS
           Existing section retained.
      ================================================== -->

      <section
        class="how-it-works"
        id="how-it-works"
      >

        <div class="section-container">

          <div class="section-intro centered">

            <p class="section-label">
              
            </p>

            <h2>
              HOW SELF ALCHEMY WORKS
            </h2>

          </div>


          <div class="how-steps">

            <div class="how-step step-one">

              <div class="step-number">
                01
              </div>

              <h3>
                Look Within
              </h3>

              <p>
                Begin with the questions, experiences, patterns,
                and challenges that brought you here.
              </p>

            </div>


            <div class="how-step step-two">

              <div class="step-number">
                02
              </div>

              <h3>
                Understand
              </h3>

              <p>
                Explore your <strong>core identity, values, beliefs,
                emotional patterns, and astrological blueprint</strong>
                to understand what may be shaping your career choices
                and relationships.
              </p>

            </div>


            <div class="how-step step-three">

              <div class="step-number">
                03
              </div>

              <h3>
                Transform
              </h3>

              <p>
                Turn awareness into conscious choices through
                practical tools, guided reflection, mentoring,
                and a personalised vision for moving forward.
              </p>

            </div>

          </div>


          <div class="how-statement">

            <span class="statement-mark">
              “
            </span>

            <p>
              Self Alchemy isn't about predicting your future.
              It's about helping you understand yourself well enough
              to participate consciously in creating it.
            </p>

          </div>

        </div>

      </section>


      <!-- ==================================================
           PEOPLE BEHIND SELF ALCHEMY
           Existing structure retained.
      ================================================== -->

      <section
        class="founders"
        id="founders"
      >

        <div class="section-container">

          <div class="section-intro centered">

            <p class="section-label">
              
            </p>

            <h2>
              THE PEOPLE BEHIND SELF ALCHEMY
            </h2>

            

          </div>


          <!-- Small 3-person visual grouping -->

          <!--<div class="founder-orbit">

            <div class="founder-circle founder-circle-one">

              <img
                src="/images/founder-karthik.png"
                alt="Karthik"
              />

            </div>


            <div class="founder-circle founder-circle-two">

              <img
                src="/images/founder-muthu.png"
                alt="Muthu Vijayan Elango"
              />

            </div>


            <div class="founder-circle founder-circle-three">

              <img
                src="/images/founder-aswin.png"
                alt="Aswin Subramanyan"
              />

            </div>

          </div> -->


          <div class="founder-grid">

            {founders.map((founder) => (

              <article class="founder-card">

                <div class="founder-image-wrap">

                  <div class="founder-image-placeholder">

                    <img
                      src={founder.image}
                      alt={founder.name}
                    />

                  </div>

                </div>


                <div class="founder-card-copy">

                  <h3>
                    {founder.name}
                  </h3>

                  <p class="founder-role">
                    {founder.role}
                  </p>

                  <p>
                    {founder.text}
                  </p>

                  <a
                    href="/founders"
                    class="text-link"
                  >
                    Know More →
                  </a>

                </div>

              </article>

            ))}

          </div>


          <div class="founder-closing">

            <strong>
              Together, we created Self Alchemy to make transformation
              experiential — not merely theoretical.
            </strong>

          </div>

        </div>

      </section>


      <!-- ==================================================
           TESTIMONIALS
           Two videos side by side.
      ================================================== -->

      <section
        class="testimonials"
        id="testimonials"
      >

        <div class="section-container">

          <div class="section-intro centered">

            <p class="section-label">
              
            </p>

            <h2>
              PARTICIPANT STORIES
            </h2>

            <p>
              Hear directly from people who experienced Self Alchemy.
            </p>

          </div>


          <div class="testimonial-video-grid">

            <div class="testimonial-video">

              <iframe
                src="https://www.youtube.com/embed/JRkyNg2UXv0?start=86"
                title="Self Alchemy Testimonial"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen>
              </iframe>

            </div>


            <div class="testimonial-video">

              <iframe
                src="https://www.youtube.com/embed/Lky2Zs0Mwfw?start=1"
                title="Self Alchemy Experience"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen>
              </iframe>

            </div>

          </div>


          <div class="testimonial-caption">

            <p>
              Real experiences. Real reflection.
              A different way of understanding yourself.
            </p>

          </div>

        </div>

      </section>


      <!-- ==================================================
           START YOUR SELF ALCHEMY JOURNEY
           FINAL SECTION
      ================================================== -->

      <section
        class="journey"
        id="journey"
      >

        <div class="journey-decoration"></div>

        <div class="section-container">

          <div class="journey-heading">

            <p class="section-label">
              START YOUR SELF ALCHEMY JOURNEY
            </p>

            <h2>
              Tell us a little about yourself
              and what you'd like to explore.
            </h2>

          </div>


          <form
            class="journey-form"
            action="mailto:karthikrs108108@gmail.com"
            method="post"
            enctype="text/plain"
          >

            <div class="form-grid">

              <div class="form-field">

                <label for="name">
                  Name *
                </label>

                <input
                  id="name"
                  name="Name"
                  type="text"
                  required
                  placeholder="Your name"
                />

              </div>


              <div class="form-field">

                <label for="email">
                  Email *
                </label>

                <input
                  id="email"
                  name="Email"
                  type="email"
                  required
                  placeholder="you@example.com"
                />

              </div>


              <div class="form-field">

                <label for="phone">
                  Phone *
                </label>

                <input
                  id="phone"
                  name="Phone"
                  type="tel"
                  required
                  placeholder="Your phone number"
                />

              </div>


              <div class="form-field">

                <label for="interest">
                  What would you like to explore?
                </label>

                <select
                  id="interest"
                  name="Interest"
                >

                  <option value="">
                    Select an area
                  </option>

                  <option>
                    Relationships & Marriage
                  </option>

                  <option>
                    Career & Life Direction
                  </option>

                  <option>
                    Major Life Decisions
                  </option>

                  <option>
                    Personal Growth
                  </option>

                  <option>
                    Purpose & Vision
                  </option>

                  <option>
                    Life Transitions
                  </option>

                  <option>
                    Retreats
                  </option>

                  <option>
                    Other
                  </option>

                </select>

              </div>

            </div>


            <div class="form-field">

              <label for="message">
                Tell us a little more
              </label>

              <textarea
                id="message"
                name="Message"
                rows="6"
                placeholder="What brings you to Self Alchemy?"
              ></textarea>

            </div>


            <button
              type="submit"
              class="cta-button form-button"
            >
              Start Your Conversation
              <span>→</span>
            </button>


            <p class="form-note">
              Your information will only be used to respond to
              your enquiry.
            </p>

          </form>

        </div>

      </section>

    </main>


    <!-- ==================================================
         FOOTER
    ================================================== -->

    <footer class="site-footer">

      <div class="footer-main">

        <div class="footer-brand">

          <h3>
            Self Alchemy
          </h3>

          <p>
            Where Astrology, self-awareness and guided
            transformation come together.
          </p>

        </div>


        <div class="footer-column">

          <h4>
            Explore
          </h4>

          <a href="#what-is-self-alchemy">
            What Is Self Alchemy
          </a>

          <a href="#next-self-alchemy">
            Next Self Alchemy
          </a>

          <a href="#how-it-works">
            How It Works
          </a>

          <a href="/founders">
            Founders
          </a>

          <a href="#testimonials">
