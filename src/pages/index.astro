      .next-form-button {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        padding: 15px 25px;

        border: 1px solid var(--green);

        border-radius: 100px;

        color: var(--green);

        font-weight: 700;
      }

      .next-form-button:hover {
        background: var(--green);
        color: white;
      }

      .next-visual {
        position: relative;

        min-height: 430px;

        display: flex;

        align-items: center;
        justify-content: center;
