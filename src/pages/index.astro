      .statement-mark {
        position: absolute;

        left: 25px;
        top: 5px;

        color: var(--orange-light);

        font-size: 4rem;

        line-height: 1;
      }

      .how-statement p {
        margin: 0;

        font-size: 1.1rem;
      }


