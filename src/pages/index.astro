    <style>

      /* ==================================================
         VARIABLES
      ================================================== */

      :global(:root) {
        --green: #31594d;
        --green-dark: #24463d;
        --green-soft: #55766a;

        --cream: #f6f0e4;
        --cream-dark: #ebe0cf;

        --orange: #c77b4a;
        --orange-light: #dfa27a;

        --text: #29342f;
        --muted: #65716b;
        --white: #ffffff;

        --border: rgba(49, 89, 77, 0.18);

        --max-width: 1180px;
        --radius: 22px;
      }


      /* ==================================================
         RESET
      ================================================== */

      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: var(--text);
        background: var(--cream);
        line-height: 1.7;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      :global(img) {
        max-width: 100%;
      }


      /* ==================================================
         TYPOGRAPHY
      ================================================== */

      h1,
      h2,
      h3,
      h4,
      p {
        margin-top: 0;
      }

      h1,
      h2,
      h3 {
        line-height: 1.15;
      }

      h1 {
        font-size: clamp(2.8rem, 6vw, 5.2rem);
      }

      h2 {
        font-size: clamp(2.2rem, 4vw, 3.5rem);
      }

      h3 {
        font-size: 1.35rem;
      }


      /* ==================================================
         CONTAINERS
      ================================================== */

      .section-container {
        width: min(
          calc(100% - 40px),
          var(--max-width)
        );

        margin: 0 auto;
      }

      .section-intro {
        max-width: 720px;
        margin-bottom: 60px;
      }

      .section-intro.centered {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }

      .section-label {
        color: var(--orange);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      .light-label {
        color: var(--orange-light);
      }


      /* ==================================================
         HEADER
      ================================================== */

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;

        padding: 16px 5%;

        background: rgba(246, 240, 228, 0.94);
        backdrop-filter: blur(12px);

        border-bottom: 1px solid var(--border);
      }

      .logo-link img {
        display: block;
        width: 115px;
        height: auto;
      }

      .site-header nav {
        display: flex;
        gap: 30px;
        align-items: center;
      }

      .site-header nav a {
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.2s ease;
      }

      .site-header nav a:hover {
        color: var(--orange);
      }

      .header-cta {
        padding: 11px 18px;

        border: 1px solid var(--green);
        border-radius: 100px;

        color: var(--green);
        font-size: 0.85rem;
        font-weight: 700;

        transition: all 0.2s ease;
      }

      .header-cta:hover {
        background: var(--green);
        color: white;
      }


      /* ==================================================
         BUTTONS
      ================================================== */

      .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 14px;

        padding: 15px 25px;

        border: 0;
        border-radius: 100px;

        background: var(--orange);
        color: white;

        font: inherit;
        font-weight: 700;

        cursor: pointer;

        transition:
          transform 0.2s ease,
          background 0.2s ease;
      }

      .cta-button:hover {
        transform: translateY(-2px);
        background: #b96d3d;
      }

      .outline-button {
        display: inline-flex;
        align-items: center;
        gap: 12px;

        margin-top: 15px;
        padding: 13px 21px;

        border: 1px solid rgba(255,255,255,0.55);
        border-radius: 100px;

        color: white;
        font-weight: 700;
      }

      .outline-button:hover {
        background: rgba(255,255,255,0.1);
      }


      /* ==================================================
         HERO
      ================================================== */

      .hero {
        position: relative;
        overflow: hidden;

        min-height: 720px;

        display: flex;
        align-items: center;

        padding: 80px 0 100px;

        background: var(--green);
        color: white;
      }

      .hero-layout {
        position: relative;
        z-index: 2;

        width: min(
          calc(100% - 40px),
          var(--max-width)
        );

        margin: 0 auto;

        display: grid;
        grid-template-columns: 1fr 0.9fr;
        align-items: center;
        gap: 70px;
      }

      .hero-copy {
        max-width: 650px;
      }

      .hero-label {
        color: var(--orange-light);
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: 4px;
      }

      .hero h1 {
        margin: 10px 0 20px;
        font-size: 3.85rem;
      }
      

      .hero-lead {
        max-width: 600px;
        font-size: 1.25rem;
        line-height: 1.6;
      }

      .hero-description {
        max-width: 560px;
        color: rgba(255,255,255,0.78);
        margin-bottom: 30px;
      }

      .hero-visual {
        position: relative;
        min-height: 480px;

        display: flex;
        align-items: center;
        justify-content: center;
      }

      .hero-visual-shape {
        position: absolute;

        width: 430px;
        height: 430px;

        background: var(--orange);

        border-radius:
          52% 48% 43% 57% /
          45% 55% 47% 53%;

        opacity: 0.8;

        transform: rotate(-12deg);
      }

      .hero-image {
        position: relative;
        z-index: 2;

        width: 160%;
        max-width: 2800px;

        
        height: 190%;
        object-fit: cover;
        object-position: center 50%;
        transform: translateX(30px)

        filter: drop-shadow(
          0 25px 35px rgba(0,0,0,0.15)
        );
      }

      .hero-decoration {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
      }

      .hero-decoration-one {
        width: 180px;
        height: 180px;
        right: -80px;
        top: 60px;
        background: var(--orange);
        opacity: 0.13;
      }

      .hero-decoration-two {
        width: 100px;
        height: 100px;
        left: 8%;
        bottom: -45px;
        background: var(--cream);
        opacity: 0.12;
      }


      /* ==================================================
         ABOUT
      ================================================== */

      .about {
        padding: 100px 0;
        background: var(--cream);
      }

      .about-layout {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 200px;
        align-items: center;
      }

      .about-heading h2 {
        margin-bottom: 0;
      }

      .about-copy {
        max-width: 680px;
        font-size: 1.3rem;
      }

      .about-copy .large-copy {
        font-size: 1.3rem;
        line-height: 1.7;
      }


      /* ==================================================
         HOW IT WORKS
      ================================================== */

      .how-it-works {
        position: relative;
        padding: 120px 0;

        background: white;

        overflow: hidden;
      }

      .how-it-works h2 {
        color: var(--orange);
        
      }


      .how-steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }

      .how-step {
        position: relative;

        min-height: 300px;
        padding: 35px;

        border-radius: var(--radius);

        background: var(--cream);

        border: 2px solid var(--green);

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
          text-align: center
      }

      .how-step:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(49,89,77,0.1);
        background: var(--white);
      }

      .step-one {
        border-color: var(--orange);
      }

      .step-two {
        border-color: var(--green);
      }

      .step-three {
        border-color: var(--orange);
      }

      .step-number {
        margin-bottom: 45px;

        color: var(--orange);

        font-size: 2.0rem;
        font-weight: 800;
        letter-spacing: 2px;

        text-align: center
      }

      .how-step p {
        color: var(--muted);
      }

      .how-statement {
        position: relative;

        max-width: 850px;
        margin: 70px auto 0;
        padding: 35px 45px;
        font-size: 4rem;

        border-radius: var(--radius);
        

        background: var(--green);
        color: white;

        text-align: center;

        
      }

      .how-statement p {
        margin: 0;
        font-size: 1.35rem !important;
        line-height: 1.6;
        font-weight: 500;
      }

      .statement-mark {
        position: absolute;
        left: 25px;
        top: 5px;

        color: var(--orange-light);
        font-size: 4rem;
        line-height: 1;
      }

      .closing-mark {
        left: auto;
        right: 25px;
        top: auto;
        bottom: 5px;
      }

      .how-statement p {
        margin: 0;
        font-size: 1.1rem;
      }


      /* ==================================================
         EXPLORE
      ================================================== */

      .explore {
        padding: 120px 0;
        background: var(--cream-dark);
      }

      .explore h2 {
        color: var(--orange);
        
      }

      .explore-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .explore-card {
        min-height: 245px;
        padding: 30px;

        background: var(--cream);

        border: 1px solid var(--border);
        border-radius: var(--radius);

        text-align: center;

        transition:
          transform 0.2s ease,
          border-color 0.2s ease;
      }

      .explore-card:hover {
        transform: translateY(-4px);
        border-color: var(--orange);
      }

      .card-number {
        display: block;
        margin-bottom: 35px;

        color: var(--orange);
        font-size: 2.0rem;
        font-weight: 800;
      }

      .explore-card p {
        color: var(--muted);
      }


      /* ==================================================
         EXPERIENCES
      ================================================== */

      .experiences {
        padding: 120px 0;
        background: var(--cream);
      }

      .experience-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      .experience-card {
        padding: 35px 28px;

        border-radius: var(--radius);

        background: white;

        border: 1px solid var(--border);

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .experience-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 18px 35px rgba(49,89,77,0.08);
      }

      .experience-featured {
        background: var(--white);
        color: muted;
        
      }
      

      .experience-featured p {
        color: rgba(255, 255, 255, 0.73);
      }

      .experience-featured-icon {
        margin-bottom: 35px;

        color: var(--orange);
        font-size: 1.8rem;
      }


      .experience-icon {
        margin-bottom: 35px;

        color: var(--orange);
        font-size: 1.8rem;
      }

      .experience-card p {
        color: var(--muted);
      }


      /* ==================================================
         RETREATS
      ================================================== */

      .retreats {
        position: relative;
        overflow: hidden;

        padding: 120px 0;

        background: var(--green);
        color: white;
      }

      .retreat-layout {
        position: relative;
        z-index: 2;

        display: grid;
        grid-template-columns: 1fr 0.9fr;
        gap: 80px;
        align-items: center;
      }

      .retreat-copy {
        max-width: 620px;
      }

      .retreat-copy h2 {
        margin-bottom: 30px;
      }

      .retreat-lead {
        font-size: 1.25rem;
      }

      .retreat-copy p {
        color: rgba(255,255,255,0.78);
      }

      .retreat-copy strong {
        color: white;
      }

      .retreat-words {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;

        margin: 30px 0;
      }

      .retreat-words span {
        padding: 7px 13px;

        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 100px;

        color: white;
        font-size: 0.85rem;
      }

      .retreat-visual {
        position: relative;
      }

      .image-placeholder {
          display: flex;
          align-items: center;
          justify-content: center;

          width: 100%;
          height: 420px;

          border-radius: 16px;
         
          border: 2px solid #c77b4a; 

          overflow: hidden;

          background: rgba(255,255,255,0.07);

          text-align: center;
        }

    .image-placeholder img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

      .image-placeholder span {
        color: var(--orange-light);
        font-size: 1.2rem;
        font-weight: 700;
      }

      .image-placeholder small {
        color: rgba(255,255,255,0.55);
      }

      .retreat-themes {
        margin-top: 18px;
        padding: 25px;

        background: var(--cream);
        color: var(--text);

        border-radius: var(--radius);
      }

      .retreat-themes h3 {
        margin-bottom: 20px;
      }

      .theme-item {
        display: grid;
        grid-template-columns: 0.65fr 1fr;
        gap: 15px;

        padding: 13px 0;

        border-bottom: 1px solid var(--border);
      }

      .theme-item:last-child {
        border-bottom: 0;
      }

      .theme-item span {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .retreat-decoration {
        position: absolute;

        width: 420px;
        height: 420px;

        right: -170px;
        top: -100px;

        background: var(--orange);

        border-radius:
          45% 55% 60% 40% /
          50% 45% 55% 50%;

        opacity: 0.12;
      }


      /* ==================================================
         FOUNDERS
      ================================================== */

      .founders {
        padding: 120px 0;
        background: var(--cream);
      }

      .intro-copy {
        max-width: 700px;
        margin: 0 auto 25px;
      }

      .founder-belief {
        max-width: 620px;
        margin: 0 auto;

        color: var(--green);
        font-size: 1.15rem;
      }

      .founders h2 {
        color: var(--orange);
        
      }

      .founder-orbit {
        position: relative;

        width: 360px;
        height: 230px;

        margin: 60px auto;
      }

      .founder-circle {
        position: absolute;

        width: 120px;
        height: 120px;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 6px solid var(--cream);

        overflow: hidden;
      }

      .founder-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .founder-circle-one {
        left: 45px;
        top: 5px;
        background: var(--green);
      }

      .founder-circle-one img {
        width: 120%;
        height: 120%;
        object-fit: cover;
        transform: translateY(-5px);
      }

      .founder-circle-two {
        right: 45px;
        top: 5px;
        background: var(--orange);
      }

      .founder-circle-two img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 15%;
      }

      .founder-circle-three {
        left: 120px;
        bottom: 0;
        background: var(--green-soft);
      }

      .founder-circle-three img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 15%;
    }

      .founder-placeholder {
        width: 95px;
        height: 95px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: rgba(255,255,255,0.15);
        color: white;

        font-size: 1.6rem;
        font-weight: 700;
      }

      .orbit-center {
        position: absolute;

        left: 50%;
        top: 52%;

        transform: translate(-50%, -50%);

        color: var(--text);

        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 2px;

        text-align: center;
      }

      .founder-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
      }

      .founder-card {
        overflow: hidden;

        background: white;

        border-radius: var(--radius);
        border: 1px solid var(--border);
      }

      .founder-image-wrap {
        padding: 25px 25px 0;
      }

      .founder-image-placeholder {
        height: 250px;

        overflow: hidden;

        background: var(--green);

        border-radius:
          22px 22px 55px 55px;
      }

      .founder-image-placeholder img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
      }

      .founder-card:nth-child(1) .founder-image-placeholder img {
        object-position: center 20%;
      }

      .founder-card:nth-child(2) .founder-image-placeholder img {
        object-position: center 10%;
      }

      .founder-card:nth-child(3) .founder-image-placeholder img {
        object-position: center 10%;
      }

      .founder-card-copy {
        padding: 28px;
      }

      .founder-card-copy h3 {
        margin-bottom: 5px;
      }

      .founder-role {
        color: var(--orange) !important;
        font-size: 0.82rem;
        font-weight: 700;
      }

      .founder-card-copy p {
        color: var(--muted);
      }

      .text-link {
        color: var(--green);
        font-weight: 800;
        font-size: 0.9rem;
      }

      .founder-closing {
        max-width: 780px;

        margin: 60px auto 0;

        text-align: center;
      }

      .founder-closing strong {
        display: block;
        margin-top: 20px;

        color: var(--green);
        font-size: 1.1rem;
      }


      /* ==================================================
         TESTIMONIALS
      ================================================== */

      .testimonials {
        padding: 120px 0;
        background: white;
      }

      .testimonials h2 {
        color: var(--orange);
        
      }

      .testimonial-video-placeholder,
      .promo-placeholder {
        min-height: 350px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        margin-bottom: 50px;

        border-radius: 28px;

        background: var(--green);
        color: white;

        text-align: center;
      }

      .testimonial-video-placeholder span {
        color: var(--orange-light);
        font-size: 1.3rem;
        font-weight: 700;
      }

      .testimonial-video-placeholder small {
        color: rgba(255,255,255,0.55);
      }



      .testimonial-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      blockquote {
        margin: 0;
        padding: 25px;

        background: var(--cream);

        border-left: 3px solid var(--orange);
        border-radius: 0 var(--radius) var(--radius) 0;
      }

      blockquote p {
        margin: 0;
        font-size: 0.95rem;
      }


      /* ==================================================
         PROMO
      ================================================== */

      .promo-video {
        padding: 120px 0;
        background: var(--cream-dark);
      }

      .promo-video h2 {
        color: var(--orange);
        
      }

      .promo-placeholder {
        margin-bottom: 0;
        min-height: 430px;
      }

      .play-button {
        width: 70px;
        height: 70px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 20px;

        border-radius: 50%;

        background: var(--orange);

        font-size: 1.2rem;
      }

      .promo-placeholder p {
        margin-bottom: 5px;
        font-size: 1.15rem;
        font-weight: 700;
      }

      .promo-placeholder span {
        max-width: 650px;
        color: rgba(255,255,255,0.65);
        font-size: 0.85rem;
      }


      /* ==================================================
         FAQ
      ================================================== */

      .faq {
        padding: 120px 0;
        background: var(--cream);
      }

      .faq-layout {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        gap: 100px;
      }

      .faq-list details {
        padding: 25px 0;
        border-bottom: 1px solid var(--border);
      }

      .faq-list summary {
        cursor: pointer;

        padding-right: 30px;

        color: var(--green);

        font-size: 1.05rem;
        font-weight: 700;
      }

      .faq-list details p {
        max-width: 700px;
        margin: 18px 0 0;

        color: var(--muted);
      }


      /* ==================================================
         JOURNEY / FORM
      ================================================== */

      .journey {
        position: relative;
        overflow: hidden;

        padding: 120px 0;

        background: var(--green);
        color: white;
      }

      .journey-heading {
        max-width: 700px;
        margin-bottom: 55px;
      }

      .journey-heading h2 {
        margin-bottom: 0;
      }

      .journey-form {
        max-width: 900px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
      }

      .form-field {
        display: flex;
        flex-direction: column;
        gap: 8px;

        margin-bottom: 22px;
      }

      .form-field label {
        font-size: 0.85rem;
        font-weight: 700;
      }

      .form-field input,
      .form-field select,
      .form-field textarea {
        width: 100%;

        padding: 14px 16px;

        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 10px;

        background: rgba(255,255,255,0.08);
        color: white;

        font: inherit;
      }

      .form-field input::placeholder,
      .form-field textarea::placeholder {
        color: rgba(255,255,255,0.5);
      }

      .form-field select option {
        color: var(--text);
      }

      .form-field textarea {
        resize: vertical;
      }

      .form-button {
        border: 0;
      }

      .form-note {
        margin-top: 15px;

        color: rgba(255,255,255,0.5);
        font-size: 0.8rem;
      }


      /* ==================================================
         FINAL CTA
      ================================================== */

      .final-cta {
        position: relative;
        overflow: hidden;

        padding: 120px 0;

        background: var(--cream);
        text-align: center;
      }

      .final-cta-content {
        position: relative;
        z-index: 2;

        max-width: 850px;
      }

      .final-cta h2 {
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
      }

      .final-cta-content > p:not(.section-label) {
        max-width: 650px;
        margin: 0 auto 30px;

        color: var(--muted);
      }
      

      .final-buttons {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
      }

      .light-button {
        background: var(--green);
      }

      .whatsapp-button {
        display: inline-flex;
        align-items: center;

        padding: 15px 25px;

        border: 1px solid var(--green);
        border-radius: 100px;

        color: var(--green);
        font-weight: 700;
      }

      .whatsapp-button:hover {
        background: var(--green);
        color: white;
      }

      .final-cta-shape {
        position: absolute;

        width: 300px;
        height: 220px;

        left: -100px;
        bottom: -80px;

        background: var(--orange);

        border-radius:
          55% 45% 40% 60% /
          50% 60% 40% 50%;

        opacity: 0.13;
      }


      /* ==================================================
         FOOTER
      ================================================== */

      .site-footer {
        background: var(--green-dark);
        color: white;
      }

      .footer-main {
        width: min(
          calc(100% - 40px),
          var(--max-width)
        );

        margin: 0 auto;

        padding: 70px 0;

        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 60px;
      }

      .footer-brand h3 {
        color: var(--orange-light);
      }

      .footer-brand p {
        max-width: 350px;
        color: rgba(255,255,255,0.65);
      }

      .footer-column {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }

      .footer-column h4 {
        margin-bottom: 10px;
        color: var(--orange-light);
      }

      .footer-column a {
        color: rgba(255,255,255,0.7);
        font-size: 0.9rem;
      }

      .footer-column a:hover {
        color: white;
      }

      .footer-bottom {
        width: min(
          calc(100% - 40px),
          var(--max-width)
        );

        margin: 0 auto;

        padding: 22px 0;

        display: flex;
        justify-content: space-between;
        gap: 20px;

        border-top: 1px solid rgba(255,255,255,0.12);

        color: rgba(255,255,255,0.5);

        font-size: 0.78rem;
      }

      .footer-bottom div {
        display: flex;
        gap: 20px;
      }


      /* ==================================================
         RESPONSIVE
      ================================================== */

      @media (max-width: 950px) {

        .site-header nav {
          gap: 15px;
        }

        .hero-layout,
        .retreat-layout,
        .about-layout,
        .faq-layout {
          grid-template-columns: 1fr;
          gap: 55px;
        }

        .hero {
          padding-top: 70px;
        }

        .hero-copy {
          text-align: center;
          margin: 0 auto;
        }

        .hero-visual {
          min-height: 400px;
        }

        .hero-description {
          margin-left: auto;
          margin-right: auto;
        }

        .how-steps,
        .explore-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .experience-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .retreats { 
         .image-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            height: 320px;

            border-radius: 32px;
          
            border: 2px solid #c77b4a; 

            overflow: hidden;

            background: rgba(255,255,255,0.07);

            text-align: center;
          }

        

        }

        .founder-grid {
          grid-template-columns: 1fr;
          max-width: 600px;
          margin: 0 auto;
        }

      

        .testimonial-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .faq-heading {
          max-width: 600px;
        }

        .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 22px;
      }

      }


      /* ==================================================
        MOBILE MENU
      ================================================== */

      .menu-toggle {
        display: none;
      }


      /* ==================================================
        MOBILE
      ================================================== */

      @media (max-width: 700px) {

        .site-header {
          position: relative;
        }

        

        .how-steps,
        .explore-grid,
        .experience-grid,
        .testimonial-grid {
          grid-template-columns: 1fr;
        }

        

        .menu-toggle {
          display: flex;

          width: 42px;
          height: 42px;

          padding: 8px;

          border: none;
          background: transparent;

          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 5px;

          cursor: pointer;
        }

        .menu-toggle span {
          display: block;

          width: 24px;
          height: 2px;

          background: var(--green);
        }

        /* Hide desktop navigation */
        .site-header nav {
          display: none;
        }

        /* Show mobile navigation when opened */
        .site-header nav.mobile-open {
          display: flex;

          position: absolute;

          top: 100%;
          left: 0;
          right: 0;

          flex-direction: column;
          gap: 0;

          padding: 15px 20px;

          background: var(--cream);

          border-bottom: 1px solid var(--border);

          box-shadow: 0 10px 25px rgba(0,0,0,0.08);

          z-index: 200;
        }

        .site-header nav.mobile-open a {
          padding: 13px 5px;

          border-bottom: 1px solid var(--border);
        }

        .site-header nav.mobile-open a:last-child {
          border-bottom: none;
        }

        .header-cta {
          display: none;
        }

      }


      @media (max-width: 450px) {

        .logo-link img {
          width: 95px;
        }

        .header-cta {
          display: none;
        }

        .hero h1 {
          font-size: 2.6rem;
        }

        .hero-lead {
          font-size: 1.05rem;
        }

        .hero-visual {
          min-height: 270px;
        }

        .hero-visual-shape {
          width: 250px;
          height: 250px;
        }

        .footer-main {
          grid-template-columns: 1fr;
        }

        .footer-brand {
          grid-column: auto;
        }

        .footer-bottom div {
          flex-wrap: wrap;
        }

      }

       .testimonial-video-placeholder iframe,
       .promo-placeholder iframe {
          width: 100%;
          height: 100%;
          min-height: inherit;
          display: block;
          border: 0;
          border-radius: inherit;
        }

    </style>

    <script>
      const menuToggle = document.getElementById("menu-toggle");
      const mainNav = document.getElementById("main-nav");

      menuToggle?.addEventListener("click", () => {

        const isOpen = mainNav.classList.toggle("mobile-open");

        menuToggle.setAttribute(
          "aria-expanded",
          isOpen ? "true" : "false"
        );

        menuToggle.setAttribute(
          "aria-label",
          isOpen ? "Close menu" : "Open menu"
        );

      });

      mainNav?.querySelectorAll("a").forEach((link) => {

        link.addEventListener("click", () => {

          mainNav.classList.remove("mobile-open");

          menuToggle.setAttribute(
            "aria-expanded",
            "false"
          );

          menuToggle.setAttribute(
            "aria-label",
            "Open menu"
          );

        });

      });
    </script>

  </body>
</html>