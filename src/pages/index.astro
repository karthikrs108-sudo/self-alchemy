      <section class="journey" id="journey">

        <div class="journey-decoration"></div>

        <div class="section-container">

          <div class="journey-heading">

            <p class="section-label">
              START YOUR SELF ALCHEMY JOURNEY
            </p>

            <h2>
              Tell us a little about yourself
            </h2>

          </div>


          <form
            class="journey-form"
            action="mailto:karthikrs108108@gmail.com"
            method="post"
            enctype="text/plain"
          >

            <div class="form-grid">

              <div class="form-field">

                <label for="name">
                  Name *
                </label>

                <input
                  id="name"
                  name="Name"
                  type="text"
                  required
                  placeholder="Your name"
                />

              </div>


              <div class="form-field">

                <label for="email">
                  Email *
                </label>

                <input
                  id="email"
                  name="Email"
                  type="email"
                  required
                  placeholder="you@example.com"
                />

              </div>


              <div class="form-field">

                <label for="phone">
                  Phone *
                </label>

                <input
                  id="phone"
                  name="Phone"
                  type="tel"
                  required
                  placeholder="Your phone number"
                />

              </div>


              <div class="form-field">

                <label for="interest">
                  What would you like to explore?
                </label>

                <select
                  id="interest"
                  name="Interest"
                >

                  <option value="">
