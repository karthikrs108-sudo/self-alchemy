<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Self Alchemy — Transform the Way You Understand Yourself</title>
    <meta
      name="description"
      content="Self Alchemy brings together Astrology, Psychology-informed self-reflection, and guided mentorship to create meaningful transformation."
    />
  </head>

  <body>

    <!-- ==================================================
         HEADER
    ================================================== -->

    <header class="site-header">

      <a href="/" class="logo-link">
        <img
          src="/No BG Logo.png"
          alt="Self Alchemy"
        />
      </a>

      <nav id="main-nav">
        <a href="#how-it-works">How It Works</a>
        <a href="#retreats">Retreats</a>
        <a href="/founders">Founders</a>
        <a href="#faq">FAQ</a>
      </nav>

      <a href="#journey" class="header-cta">
        Begin Your Journey
      </a>

      <!-- MOBILE MENU BUTTON -->
      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
