      .retreat-themes h3 {
        margin-bottom: 20px;
      }

      .theme-item {
        display: grid;

        grid-template-columns: 0.65fr 1fr;

        gap: 15px;

        padding: 13px 0;

        border-bottom: 1px solid var(--border);
      }

      .theme-item:last-child {
        border-bottom: 0;
      }

      .theme-item span {
        color: var(--muted);
        font-size: 0.88rem;
      }

      .retreat-decoration {
        position: absolute;

        width: 420px;
        height: 420px;

        right: -170px;
        top: -100px;

        background: var(--orange);

        border-radius:
          45% 55% 60% 40% /
          50% 45% 55% 50%;

        opacity: 0.10;
      }


      /* ==================================================
         NEXT SELF ALCHEMY
      ================================================== */

      .next-self-alchemy {
        position: relative;
        overflow: hidden;

        padding: 110px 0;

        background: var(--cream-dark);
      }

      .next-inner {
        position: relative;
        z-index: 2;

        display: grid;

        grid-template-columns: 1fr 0.85fr;

        gap: 80px;

        align-items: center;
