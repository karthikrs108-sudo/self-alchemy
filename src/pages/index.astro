        <span></span>
        <span></span>
        <span></span>
      </button>

    </header>


    <main>

      <!-- ==================================================
           HERO
      ================================================== -->

      <section class="hero">

        <div class="hero-decoration hero-decoration-one"></div>
        <div class="hero-decoration hero-decoration-two"></div>

        <div class="hero-layout">

          <div class="hero-copy">

            <p class="hero-label">
              SELF ALCHEMY
