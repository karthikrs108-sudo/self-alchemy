        background: var(--cream);
      }

      .intro-copy {
        max-width: 700px;

        margin: 0 auto 25px;
      }

      .founder-belief {
        max-width: 620px;

        margin: 0 auto;

        color: var(--green);

        font-size: 1.15rem;
      }

      .founder-orbit {
        position: relative;

        width: 360px;
        height: 230px;

        margin: 60px auto;
      }

      .founder-circle {
        position: absolute;

        width: 120px;
        height: 120px;

        display: flex;

        align-items: center;
        justify-content: center;

        border: 6px solid var(--cream);

        border-radius: 50%;

        overflow: hidden;
      }

      .founder-circle img {
        width: 100%;
        height: 100%;

        object-fit: cover;

        object-position: center top;
      }

      .founder-circle-two img,
      .founder-circle-three img {
        object-position: center 15%;
      }

      .founder-circle-one {
        left: 45px;
        top: 5px;

        background: var(--green);
      }

      .founder-circle-one img {
        width: 120%;
        height: 120%;

        object-fit: cover;

        transform: translateY(-5px);
      }

      .founder-circle-two {
        right: 45px;
        top: 5px;

        background: var(--orange);
      }

      .founder-circle-three {
        left: 120px;
        bottom: 0;

        background: var(--green-soft);
      }

      .founder-grid {
        display: grid;

        grid-template-columns:
          repeat(3, 1fr);

        gap: 22px;
      }

      .founder-card {
        overflow: hidden;

        background: white;

        border-radius: var(--radius);

        border: 1px solid var(--border);
      }

      .founder-image-wrap {
        padding: 25px 25px 0;
      }

      .founder-image-placeholder {
        height: 250px;

        overflow: hidden;

        background: var(--green);

        border-radius:
          22px 22px 55px 55px;
      }

      .founder-image-placeholder img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;

        object-position: center top;
      }

      .founder-card:nth-child(1)
      .founder-image-placeholder img {
        object-position: center 20%;
      }

      .founder-card:nth-child(2)
      .founder-image-placeholder img,
      .founder-card:nth-child(3)
      .founder-image-placeholder img {
        object-position: center 10%;
      }

      .founder-card-copy {
        padding: 28px;
      }

      .founder-card-copy h3 {
        margin-bottom: 5px;
      }

      .founder-role {
        color: var(--orange) !important;

        font-size: 0.82rem;
        font-weight: 700;
      }

      .founder-card-copy p {
        color: var(--muted);
      }

      .text-link {
        color: var(--green);

        font-weight: 800;

        font-size: 0.9rem;
      }

      .founder-closing {
        max-width: 780px;

        margin: 60px auto 0;

        text-align: center;
      }

      .founder-closing strong {
        display: block;

        margin-top: 20px;

        color: var(--green);

        font-size: 1.1rem;
      }


      /* ==================================================
         TESTIMONIALS
      ================================================== */

      .testimonials {
        padding: 120px 0;

        background: white;
      }

      .testimonial-video-grid {
        display: grid;

        grid-template-columns:
          repeat(2, 1fr);

        gap: 22px;
      }

      .testimonial-video {
        overflow: hidden;

        border-radius: 28px;

        background: var(--green);

        box-shadow:
          0 15px 35px rgba(49,89,77,0.08);
      }

      .testimonial-video iframe {
        width: 100%;
        height: 340px;

        display: block;

        border: 0;
      }

      .testimonial-caption {
        max-width: 700px;

        margin: 40px auto 0;

        text-align: center;

        color: var(--muted);

        font-size: 1rem;
      }


      /* ==================================================
         JOURNEY / FORM
         Existing structure retained
      ================================================== */

      .journey {
        position: relative;

        overflow: hidden;

        padding: 120px 0;

        background: var(--green);

        color: white;
